# Enable Banking (PSD2 account information) — M5.
# Copy to .env and fill in the values from the Enable Banking control panel
# (https://enablebanking.com — API applications). .env is gitignored; never
# commit real values.
#
# BaseUrl is the same host for sandbox and production applications — the
# environment is decided by which application id you use, and sandbox
# applications only see sandbox banks. There is no sandbox.enablebanking.com.
ENABLE_BANKING_SANDBOX_URL=https://api.enablebanking.com

# The application id (a UUID) shown in the control panel. Travels as the JWT's
# `kid` header.
ENABLE_BANKING_CLIENT_ID=your_application_id_here

# Path to the PEM private key whose certificate is registered against that
# application. Relative paths resolve against the repository root.
# Also gitignored (*.pem).
ENABLE_BANKING_PRIVATE_KEY_PATH=./enable-banking-key.pem

# Optional. Overrides EnableBanking:RedirectUrl from appsettings.json. Must
# match a redirect URL registered on the Enable Banking application, or the
# bank refuses the redirect.
#ENABLE_BANKING_REDIRECT_URL=https://localhost:7027/banking/callback
