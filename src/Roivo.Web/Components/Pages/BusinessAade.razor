@page "/businesses/{Id:guid}/aade"
@attribute [Authorize]

@using Roivo.Application.Abstractions
@using Roivo.Application.Features.Aade.Commands.ConnectAade
@using Roivo.Application.Features.Aade.Commands.DisconnectAade
@using Roivo.Application.Features.Aade.Commands.SyncBusinessInvoices
@using Roivo.Application.Features.Aade.Queries.GetAadeConnectionStatus
@using Roivo.Application.Features.Businesses.Queries.GetBusinessById
@using Roivo.Core.Domain.Entities
@using Roivo.Web.Components.Shared
@inject GetBusinessByIdHandler GetBusinessHandler
@inject GetAadeConnectionStatusHandler GetStatusHandler
@inject ConnectAadeHandler ConnectHandler
@inject DisconnectAadeHandler DisconnectHandler
@inject SyncBusinessInvoicesHandler SyncHandler
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITenantContext TenantContext

<RoivoPageTitle Title="@(Aade.CredentialsEntryHeader)" />

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">

    <MudPaper Class="pa-4 mb-4">
        <BusinessBreadcrumbs BusinessId="Id" BusinessName="@business?.Name"
                             CurrentPage="@Roivo.Resources.Accountant.Aade" />
        <MudText Typo="Typo.h5">AADE myDATA</MudText>
    </MudPaper>

    @if (loading)
    {
        <MudPaper Class="pa-6">
            <SkeletonText Height="2.5rem" Class="mb-4" />
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6">
                    <SkeletonText Announce="false" Lines="2" Width="70%" LastLineWidth="90%" Height="0.9rem" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <SkeletonText Announce="false" Lines="2" Width="70%" LastLineWidth="90%" Height="0.9rem" />
                </MudItem>
            </MudGrid>
            <SkeletonText Announce="false" Width="55%" Height="2.5rem" />
        </MudPaper>
    }
    else if (business is null)
    {
        <MudAlert Severity="Severity.Warning">@Roivo.Resources.Businesses.NotFound_Error</MudAlert>
    }
    else if (status is not null && status.IsConnected)
    {
        <MudPaper Class="pa-6">
            @if (business.HasAadeFailure)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                    <MudText Typo="Typo.subtitle2">@Aade.ConnectionFailureBannerTitle</MudText>
                    <MudText Typo="Typo.body2">
                        @GetFailureMessage(business.AadeLastFailureReason)
                        @if (business.AadeLastFailureAt.HasValue)
                        {
                            <br/>
                            <span>@string.Format(Aade.ConnectionFailureBannerSince, business.AadeLastFailureAt.Value.ToLocalTime())</span>
                        }
                    </MudText>
                </MudAlert>
            }

            <MudAlert Severity="Severity.Success" Class="mb-4">
                @Aade.Connected_Description
            </MudAlert>

            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Aade.UserIdLabel</MudText>
                    <MudText Typo="Typo.body1">@status.MaskedUserId</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Aade.LastSyncHeading</MudText>
                    <MudText Typo="Typo.body1">@(status.LastSyncAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</MudText>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Sync"
                           OnClick="HandleSyncNow"
                           Disabled="@syncing">
                    @(syncing ? Aade.SyncingMessage : Aade.SyncNowButton)
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Outlined.LinkOff"
                           OnClick="HandleDisconnect">
                    @Aade.DisconnectButton
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else if (state == ScreenState.Connecting)
    {
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.body2" Class="mb-4">
                @Aade.CredentialsIntro
            </MudText>

            <MudForm @ref="form" Model="input" @bind-IsValid="isFormValid">
                <MudTextField @bind-Value="input.UserId"
                              Label="@Aade.UserIdLabel"
                              Required="true"
                              RequiredError="@Common.RequiredShort"
                              MaxLength="100"
                              Immediate="true"
                              Class="mb-4" />

                <MudTextField @bind-Value="input.SubscriptionKey"
                              Label="@Aade.SubscriptionKeyLabel"
                              Required="true"
                              RequiredError="@Common.RequiredShort"
                              MaxLength="200"
                              InputType="InputType.Password"
                              Immediate="true"
                              Class="mb-4" />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               OnClick="@(() => Nav.NavigateTo($"/businesses/{Id}"))">
                        @Common.CancelButton
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="HandleConnect"
                               Disabled="@(!isFormValid || connecting)">
                        @(connecting ? Aade.ConnectingMessage : Aade.ConnectButton)
                    </MudButton>
                </MudStack>
            </MudForm>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6" GutterBottom="true">@Aade.Status_NotConnected</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                @Aade.NotConnected_Description
                @Aade.NotConnected_Hint
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Link"
                       OnClick='() => state = ScreenState.Connecting'>
                @Aade.ConnectButton
            </MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private enum ScreenState { NotConnected, Connecting }

    private ScreenState state = ScreenState.NotConnected;
    private bool loading = true;
    private bool connecting;
    private bool syncing;
    private bool isFormValid;
    private MudForm form = null!;
    private string? errorMessage;
    private Business? business;
    private AadeConnectionInfo? status;
    private readonly ConnectInput input = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshBusinessAsync();
        if (business is null)
        {
            loading = false;
            return;
        }

        await RefreshStatusAsync();
        loading = false;
    }

    // Re-reads the Business entity so derived UI state (the failure banner)
    // reflects current DB state after Sync/Connect/Disconnect, not the
    // snapshot taken at OnInitializedAsync.
    private async Task RefreshBusinessAsync()
    {
        business = await GetBusinessHandler.Handle(new GetBusinessByIdQuery(Id, ActiveOnly: true), CancellationToken.None);
    }

    private async Task RefreshStatusAsync()
    {
        status = await GetStatusHandler.Handle(new GetAadeConnectionStatusQuery(Id), CancellationToken.None);
        if (!status.IsConnected)
            state = ScreenState.NotConnected;
    }

    private async Task HandleConnect()
    {
        await form.ValidateAsync();
        if (!isFormValid) return;

        connecting = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await ConnectHandler.Handle(
                new ConnectAadeCommand(Id, input.UserId.Trim(), input.SubscriptionKey.Trim()),
                CancellationToken.None);

            switch (result)
            {
                case ConnectAadeResult.Success:
                    Snackbar.Add(Aade.ConnectSuccess, Severity.Success);
                    input.UserId = string.Empty;
                    input.SubscriptionKey = string.Empty;
                    // Reconnect clears failure state server-side; re-read so a
                    // prior-failure banner disappears.
                    await RefreshBusinessAsync();
                    await RefreshStatusAsync();
                    return;
                case ConnectAadeResult.BusinessNotFound:
                    errorMessage = Roivo.Resources.Businesses.NotFound_Error;
                    return;
                case ConnectAadeResult.Forbidden f:
                    errorMessage = f.Reason;
                    return;
                case ConnectAadeResult.InvalidCredentials:
                    errorMessage = Aade.Error_InvalidCredentials;
                    return;
                case ConnectAadeResult.AfmMismatch mismatch:
                {
                    // Accountants can edit the business AFM (two recovery paths);
                    // business-owner tenants cannot (AFM is locked at registration),
                    // so we only suggest re-entering credentials.
                    var canEditAfm = BusinessPermissions.CanEditAfm(TenantContext.CurrentTenantType);
                    if (mismatch.CredentialsAfm is not null)
                    {
                        errorMessage = canEditAfm
                            ? Aade.Error_AfmMismatch_WithAfm_CanEditAfm.Format(mismatch.CredentialsAfm, mismatch.BusinessAfm)
                            : Aade.Error_AfmMismatch_WithAfm_CannotEditAfm.Format(mismatch.CredentialsAfm, mismatch.BusinessAfm);
                    }
                    else
                    {
                        errorMessage = canEditAfm
                            ? Aade.Error_AfmMismatch_Generic_CanEditAfm
                            : Aade.Error_AfmMismatch_Generic_CannotEditAfm.Format(mismatch.BusinessAfm);
                    }
                    return;
                }
                case ConnectAadeResult.RateLimited:
                    errorMessage = Aade.Error_RateLimited;
                    return;
                case ConnectAadeResult.AadeUnavailable:
                    errorMessage = Aade.Error_AadeUnavailable;
                    return;
            }
        }
        finally
        {
            connecting = false;
        }
    }

    private async Task HandleDisconnect()
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Title, Aade.Confirm_Disconnect_Title },
            { x => x.Message, Aade.Confirm_Disconnect_Message },
            { x => x.YesText, Aade.DisconnectButton },
            { x => x.CancelText, Common.CancelButton }
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>("", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var outcome = await DisconnectHandler.Handle(new DisconnectAadeCommand(Id), CancellationToken.None);
        switch (outcome)
        {
            case DisconnectAadeResult.Success:
                Snackbar.Add(Aade.Disconnected_Message, Severity.Info);
                state = ScreenState.NotConnected;
                // Disconnect clears failure state server-side; re-read.
                await RefreshBusinessAsync();
                await RefreshStatusAsync();
                break;
            case DisconnectAadeResult.BusinessNotFound:
                Snackbar.Add(Roivo.Resources.Businesses.NotFound_Error, Severity.Warning);
                break;
            case DisconnectAadeResult.Forbidden f:
                Snackbar.Add(f.Reason, Severity.Warning);
                break;
        }
    }

    private async Task HandleSyncNow()
    {
        syncing = true;
        StateHasChanged();

        try
        {
            var result = await SyncHandler.Handle(new SyncBusinessInvoicesCommand(Id), CancellationToken.None);
            switch (result)
            {
                case SyncBusinessInvoicesResult.Success ok:
                    Snackbar.Add(string.Format(Aade.SyncComplete, ok.NewCount, ok.UpdatedCount), Severity.Success);
                    // A successful sync clears HasAadeFailure server-side; re-read
                    // so the banner reflects that without a full page refresh.
                    await RefreshBusinessAsync();
                    await RefreshStatusAsync();
                    break;
                case SyncBusinessInvoicesResult.NotConnected:
                    Snackbar.Add(Aade.Error_ConnectionInactive, Severity.Warning);
                    await RefreshStatusAsync();
                    break;
                case SyncBusinessInvoicesResult.InvalidCredentials:
                    Snackbar.Add(Aade.Error_CredentialsRejected, Severity.Error);
                    // Handler set HasAadeFailure="InvalidCredentials"; re-read so
                    // the banner appears immediately.
                    await RefreshBusinessAsync();
                    await RefreshStatusAsync();
                    break;
                case SyncBusinessInvoicesResult.NetworkError ne:
                    Snackbar.Add(string.Format(Aade.Error_Network, ne.Message), Severity.Error);
                    break;
                case SyncBusinessInvoicesResult.AadeServerError se:
                    Snackbar.Add(string.Format(Aade.Error_HttpStatus, se.StatusCode), Severity.Error);
                    break;
                case SyncBusinessInvoicesResult.BusinessNotFound:
                    Snackbar.Add(Roivo.Resources.Businesses.NotFound_Error, Severity.Warning);
                    break;
            }
        }
        finally
        {
            syncing = false;
        }
    }

    private static string GetFailureMessage(string? reason) => reason switch
    {
        "InvalidCredentials" => Aade.FailureReasonInvalidCredentials,
        "AfmMismatch" => Aade.FailureReasonAfmMismatch,
        _ => Aade.FailureReasonGeneric
    };

    private sealed class ConnectInput
    {
        public string UserId { get; set; } = string.Empty;
        public string SubscriptionKey { get; set; } = string.Empty;
    }
}
