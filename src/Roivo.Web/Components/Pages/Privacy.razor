@page "/privacy"
@layout Roivo.Web.Components.Layout.MarketingLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Roivo.Web.Components.Shared

@*
    Privacy policy — TEMPLATE, pending review by a Greek lawyer.

    Every value that must not be invented is a bracketed placeholder
    ([COMPANY_LEGAL_NAME], [COMPANY_ADDRESS], [PRIVACY_CONTACT_EMAIL], …) so
    that no fictional company detail can ship. The list of them is in the
    remarks on Roivo.Resources.Marketing.

    LAYOUT: MarketingLayout, like Landing.razor — this page carries its own
    chrome and must not render inside the authenticated MainLayout.

    Styles are an inline <style> rather than a scoped .razor.css file to keep
    this agent inside its assigned file set; every selector is namespaced under
    .rvl-page so nothing leaks into the app. They are duplicated in
    Terms.razor — a candidate for extraction into app.css later.
*@

<RoivoPageTitle Title="@(Marketing.Privacy_PageTitle)" />

<HeadContent>
    <meta name="description" content="@Marketing.Privacy_MetaDescription" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="@Marketing.BrandName" />
    <meta property="og:title" content="@Marketing.Privacy_PageTitle" />
    <meta property="og:description" content="@Marketing.Privacy_MetaDescription" />
</HeadContent>

<div class="rvl-page">
    <style>
        .rvl-page { --navy:#0B1F3A; --blue:#1E88E5; --teal:#2DD4BF; --light:#F8FAFC; --ink:#0B1F3A; --ink-soft:#475569; --line:#E2E8F0;
            font-family:Inter,-apple-system,'Segoe UI',Roboto,sans-serif; color:var(--ink); background:var(--light); overflow-x:hidden; }
        .rvl-page *,.rvl-page *::before,.rvl-page *::after { box-sizing:border-box; }
        .rvl-shell { width:100%; max-width:820px; margin-inline:auto; padding-inline:20px; }
        .rvl-top { background:var(--navy); }
        .rvl-top-inner { display:flex; align-items:center; justify-content:space-between; gap:16px; min-height:68px; padding-block:10px; flex-wrap:wrap; }
        .rvl-brand { display:inline-flex; align-items:center; min-height:44px; text-decoration:none; }
        .rvl-back { display:inline-flex; align-items:center; min-height:44px; padding:0 14px; border-radius:999px;
            color:rgba(255,255,255,.82); text-decoration:none; font-size:.9375rem; font-weight:600;
            border:1.5px solid rgba(255,255,255,.3); transition:border-color .18s ease,background-color .18s ease,color .18s ease; }
        .rvl-back:hover,.rvl-back:focus-visible { color:#fff; border-color:var(--teal); background:rgba(45,212,191,.12); }
        .rvl-hero { background:linear-gradient(160deg,#0B1F3A 0%,#06142A 100%); color:#fff; padding-block:52px 56px; }
        .rvl-h1 { margin:0 0 10px; font-size:clamp(1.75rem,5.4vw,2.5rem); line-height:1.15; letter-spacing:-.02em; font-weight:800; }
        .rvl-updated { margin:0; font-size:.875rem; color:rgba(255,255,255,.6); }
        .rvl-body { padding-block:40px 72px; }
        .rvl-notice { border:1.5px solid #D97706; background:#FFF8EB; border-radius:14px; padding:20px 22px; margin-bottom:40px; }
        .rvl-notice-h { margin:0 0 6px; font-size:.9375rem; font-weight:800; color:#92400E; text-transform:uppercase; letter-spacing:.04em; }
        .rvl-notice-p { margin:0; font-size:.9375rem; line-height:1.6; color:#78350F; }
        .rvl-notice-sep { border:0; border-top:1px dashed #D97706; margin:16px 0; }
        .rvl-intro { margin:0 0 36px; font-size:1.0625rem; line-height:1.7; color:var(--ink-soft); }
        .rvl-sec { margin:0 0 32px; }
        .rvl-h2 { margin:0 0 12px; font-size:1.1875rem; font-weight:700; line-height:1.3; padding-bottom:8px; border-bottom:2px solid var(--teal); }
        .rvl-p { margin:0 0 12px; font-size:1rem; line-height:1.72; color:var(--ink-soft); }
        .rvl-p:last-child { margin-bottom:0; }
        .rvl-note { margin:12px 0 0; padding:12px 16px; background:#fff; border-left:3px solid var(--blue); border-radius:0 10px 10px 0;
            font-size:.9375rem; line-height:1.6; color:var(--ink); }
        .rvl-list { margin:0 0 12px; padding:0; list-style:none; display:grid; gap:10px; }
        .rvl-list li { position:relative; padding-left:24px; font-size:1rem; line-height:1.65; color:var(--ink-soft); }
        .rvl-list li::before { content:""; position:absolute; left:2px; top:9px; width:9px; height:9px; border-radius:3px;
            background:linear-gradient(135deg,#1E88E5,#2DD4BF); }
        .rvl-footer { background:var(--navy); color:rgba(255,255,255,.6); padding-block:40px 24px; }
        .rvl-footer-inner { display:flex; flex-wrap:wrap; gap:20px; justify-content:space-between; align-items:center; }
        .rvl-footer-links { display:flex; flex-wrap:wrap; gap:4px; }
        .rvl-footer-links a { display:inline-flex; align-items:center; min-height:44px; padding:0 12px;
            color:rgba(255,255,255,.78); text-decoration:none; font-size:.9375rem; }
        .rvl-footer-links a:hover,.rvl-footer-links a:focus-visible { color:var(--teal); text-decoration:underline; }
        .rvl-footer-legal { margin-top:28px; padding-top:20px; border-top:1px solid rgba(255,255,255,.1); font-size:.8125rem; color:rgba(255,255,255,.5); }
        @@media (max-width:560px) {
            .rvl-shell { padding-inline:16px; }
            .rvl-hero { padding-block:40px 44px; }
            .rvl-body { padding-block:32px 56px; }
            .rvl-notice { padding:16px 16px; }
        }
        @@media (prefers-reduced-motion:reduce) { .rvl-page *,.rvl-page *::before,.rvl-page *::after { transition:none !important; animation:none !important; } }
    </style>

    <header class="rvl-top">
        <div class="rvl-shell rvl-top-inner">
            <a href="/" class="rvl-brand" aria-label="@Marketing.Landing_LogoAlt">
                <RoivoLogo Size="34" WordmarkColor="#FFFFFF" />
            </a>
            <a href="/" class="rvl-back">@Marketing.Legal_BackToHome</a>
        </div>
    </header>

    <section class="rvl-hero">
        <div class="rvl-shell">
            <h1 class="rvl-h1">@Marketing.Privacy_Title</h1>
            <p class="rvl-updated">@Marketing.Legal_LastUpdated</p>
        </div>
    </section>

    <main class="rvl-shell rvl-body">

        @* Shown in both languages at once, deliberately: whoever lands here —
           reader, lawyer, reviewer — must see that this is not final text. *@
        <div class="rvl-notice" role="note">
            <p class="rvl-notice-h">@Marketing.Legal_TemplateNotice_Heading_El</p>
            <p class="rvl-notice-p">@Marketing.Legal_TemplateNotice_Body_El</p>
            <hr class="rvl-notice-sep" />
            <p class="rvl-notice-h">@Marketing.Legal_TemplateNotice_Heading_En</p>
            <p class="rvl-notice-p">@Marketing.Legal_TemplateNotice_Body_En</p>
        </div>

        <p class="rvl-intro">@Marketing.Privacy_Intro</p>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S1_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S1_Body</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S2_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S2_Body</p>
            <ul class="rvl-list">
                <li>@Marketing.Privacy_S2_Item1</li>
                <li>@Marketing.Privacy_S2_Item2</li>
                <li>@Marketing.Privacy_S2_Item3</li>
                <li>@Marketing.Privacy_S2_Item4</li>
                <li>@Marketing.Privacy_S2_Item5</li>
            </ul>
            <p class="rvl-note">@Marketing.Privacy_S2_Note</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S3_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S3_Body</p>
            <ul class="rvl-list">
                <li>@Marketing.Privacy_S3_Item1</li>
                <li>@Marketing.Privacy_S3_Item2</li>
                <li>@Marketing.Privacy_S3_Item3</li>
                <li>@Marketing.Privacy_S3_Item4</li>
            </ul>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S4_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S4_Body</p>
            <ul class="rvl-list">
                <li>@Marketing.Privacy_S4_Item1</li>
                <li>@Marketing.Privacy_S4_Item2</li>
                <li>@Marketing.Privacy_S4_Item3</li>
                <li>@Marketing.Privacy_S4_Item4</li>
            </ul>
            <p class="rvl-note">@Marketing.Privacy_S4_Note</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S5_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S5_Body</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S6_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S6_Body</p>
            <ul class="rvl-list">
                <li>@Marketing.Privacy_S6_Item1</li>
                <li>@Marketing.Privacy_S6_Item2</li>
                <li>@Marketing.Privacy_S6_Item3</li>
                <li>@Marketing.Privacy_S6_Item4</li>
                <li>@Marketing.Privacy_S6_Item5</li>
                <li>@Marketing.Privacy_S6_Item6</li>
                <li>@Marketing.Privacy_S6_Item7</li>
            </ul>
            <p class="rvl-p">@Marketing.Privacy_S6_Response</p>
            <p class="rvl-p">@Marketing.Privacy_S6_Complaint</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S7_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S7_Body</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S8_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S8_Body</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S9_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S9_Body</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S10_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S10_Body</p>
        </section>

        <section class="rvl-sec">
            <h2 class="rvl-h2">@Marketing.Privacy_S11_Title</h2>
            <p class="rvl-p">@Marketing.Privacy_S11_Body</p>
        </section>

    </main>

    <footer class="rvl-footer">
        <div class="rvl-shell rvl-footer-inner">
            <RoivoLogo Size="36" ShowTagline="true" WordmarkColor="#FFFFFF" />
            <nav class="rvl-footer-links" aria-label="@Marketing.Legal_TableOfContents">
                <a href="/privacy">@Marketing.Footer_Privacy</a>
                <a href="/terms">@Marketing.Footer_Terms</a>
            </nav>
        </div>
        <div class="rvl-shell rvl-footer-legal">
            <span>@Marketing.Footer_Copyright</span>
        </div>
    </footer>
</div>
