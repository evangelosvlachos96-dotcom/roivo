@page "/"
@layout Roivo.Web.Components.Layout.MarketingLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@using Roivo.Web.Components.Shared

@*
    Public landing page (M12).

    LAYOUT: MarketingLayout, not the authenticated MainLayout — this page
    carries its own chrome (top bar, hero, footer), and under MainLayout it
    rendered a second navigation above its own.

    Deliberately MudBlazor-free for that reason: MudThemeProvider and friends
    live in MainLayout, so this page has no providers above it.

    All copy comes from Roivo.Resources.Marketing. Nothing user-facing is
    hardcoded in this file.
*@

<RoivoPageTitle Title="@(Marketing.Landing_PageTitle)" />

<HeadContent>
    <meta name="description" content="@Marketing.Landing_MetaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Marketing.BrandName" />
    <meta property="og:title" content="@Marketing.Landing_PageTitle" />
    <meta property="og:description" content="@Marketing.Landing_MetaDescription" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Marketing.Landing_PageTitle" />
    <meta name="twitter:description" content="@Marketing.Landing_MetaDescription" />
</HeadContent>

<div class="landing">

    <a class="skip" href="#content">@Marketing.Landing_SkipToContent</a>

    @* ---------------------------------------------------------- top bar *@
    <header class="topbar">
        <div class="shell topbar-inner">
            <a href="/" class="topbar-brand" aria-label="@Marketing.Landing_LogoAlt">
                <RoivoLogo Size="34" WordmarkColor="#FFFFFF" />
            </a>

            <nav class="topnav" aria-label="@Marketing.Nav_Features">
                <a href="#features">@Marketing.Nav_Features</a>
                <a href="#how">@Marketing.Nav_HowItWorks</a>
                <a href="#accountants">@Marketing.Nav_Accountants</a>
                <a href="#pricing">@Marketing.Nav_Pricing</a>
            </nav>

            <div class="topbar-actions">
                <a class="btn-ghost" href="/Account/Login">@Marketing.Hero_SecondaryCta</a>
                <a class="btn-grad btn-sm" href="/Account/Register">@Marketing.Hero_PrimaryCta</a>
            </div>
        </div>
    </header>

    @* ------------------------------------------------------------- hero *@
    <section class="hero" id="content">
        <div class="shell hero-inner">
            <div class="hero-logo">
                <RoivoLogo Size="76" ShowTagline="true" WordmarkColor="#FFFFFF" />
            </div>

            <h1 class="hero-title">@Marketing.Hero_Headline</h1>
            <p class="hero-sub">@Marketing.Hero_SubHeadline</p>

            <div class="hero-cta">
                <a class="btn-grad btn-lg" href="/Account/Register">
                    <span>@Marketing.Hero_PrimaryCta</span>
                    <svg class="btn-arrow" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 12h15" />
                        <path d="M13 6l6 6-6 6" />
                    </svg>
                </a>
                <a class="btn-outline btn-lg" href="/Account/Login">@Marketing.Hero_SecondaryCta</a>
            </div>

            <p class="hero-note">@Marketing.Hero_Reassurance</p>
        </div>
    </section>

    @* --------------------------------------------------------- features *@
    <section class="section" id="features">
        <div class="shell">
            <h2 class="section-title">@Marketing.Features_Title</h2>
            <p class="section-sub">@Marketing.Features_Subtitle</p>

            <div class="cards">
                <article class="card">
                    <span class="card-icon">
                        @* PSD2 bank connection. *@
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="ico">
                            <path d="M2.5 9.2 12 4l9.5 5.2" />
                            <path d="M6 11.5v6M10 11.5v6M14 11.5v6M18 11.5v6" />
                            <path d="M3.5 20h17" />
                        </svg>
                    </span>
                    <h3 class="card-title">@Marketing.Feature_Psd2_Title</h3>
                    <p class="card-text">@Marketing.Feature_Psd2_Desc</p>
                </article>

                <article class="card">
                    <span class="card-icon">
                        @* myDATA sync: documents arriving. *@
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="ico">
                            <path d="M7 4.5A1.75 1.75 0 0 1 8.75 2.75h5L17.5 6.5v12.75A1.75 1.75 0 0 1 15.75 21h-7A1.75 1.75 0 0 1 7 19.25Z" />
                            <path d="M13.5 2.75v4h4" />
                            <path d="M12.25 10v5.5" />
                            <path d="M9.9 13.3l2.35 2.35 2.35-2.35" />
                        </svg>
                    </span>
                    <h3 class="card-title">@Marketing.Feature_MyData_Title</h3>
                    <p class="card-text">@Marketing.Feature_MyData_Desc</p>
                </article>

                <article class="card">
                    <span class="card-icon">
                        @* Reconciliation: two things linked. *@
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="ico">
                            <path d="M9.4 14.6 14.6 9.4" />
                            <path d="M11.9 7.1 13.8 5.2a3.6 3.6 0 0 1 5.1 5.1L17 12.2" />
                            <path d="M12.1 16.9 10.2 18.8a3.6 3.6 0 0 1-5.1-5.1L7 11.8" />
                        </svg>
                    </span>
                    <h3 class="card-title">@Marketing.Feature_Reconciliation_Title</h3>
                    <p class="card-text">@Marketing.Feature_Reconciliation_Desc</p>
                </article>

                <article class="card">
                    <span class="card-icon">
                        @* 90-day forecast. Forward-looking on purpose: solid
                           history, a "today" divider, then a dashed projection
                           ending in an arrow. Never a bar chart — bars report
                           what already happened. *@
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="ico">
                            <path d="M3 18.2 7 14.2l3 2 3-6" />
                            <path d="M13 10.2 20.3 4.7" stroke-dasharray="2.6 2.4" />
                            <path d="M20.3 4.7 16.3 5.3" />
                            <path d="M20.3 4.7 19.7 8.6" />
                            <path d="M13 3.2v17" stroke-dasharray="1 2.6" opacity="0.5" />
                        </svg>
                    </span>
                    <h3 class="card-title">@Marketing.Feature_Forecast_Title</h3>
                    <p class="card-text">@Marketing.Feature_Forecast_Desc</p>
                </article>

                <article class="card">
                    <span class="card-icon">
                        @* Tax obligations: an alert bell over a deadline. *@
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="ico">
                            <path d="M12 3.2a5.2 5.2 0 0 1 5.2 5.2v3.3l1.6 2.7H5.2l1.6-2.7V8.4A5.2 5.2 0 0 1 12 3.2Z" />
                            <path d="M9.8 17.6a2.2 2.2 0 0 0 4.4 0" />
                            <path d="M12 3.2V1.9" />
                        </svg>
                    </span>
                    <h3 class="card-title">@Marketing.Feature_Tax_Title</h3>
                    <p class="card-text">@Marketing.Feature_Tax_Desc</p>
                </article>
            </div>
        </div>
    </section>

    @* ----------------------------------------------------- how it works *@
    <section class="section section-alt" id="how">
        <div class="shell">
            <h2 class="section-title">@Marketing.How_Title</h2>
            <p class="section-sub">@Marketing.How_Subtitle</p>

            <ol class="steps">
                <li class="step">
                    <span class="step-num">1</span>
                    <h3 class="step-title">@Marketing.How_Step1_Label</h3>
                    <p class="card-text">@Marketing.How_Step1_Desc</p>
                </li>
                <li class="step">
                    <span class="step-num">2</span>
                    <h3 class="step-title">@Marketing.How_Step2_Label</h3>
                    <p class="card-text">@Marketing.How_Step2_Desc</p>
                </li>
                <li class="step">
                    <span class="step-num">3</span>
                    <h3 class="step-title">@Marketing.How_Step3_Label</h3>
                    <p class="card-text">@Marketing.How_Step3_Desc</p>
                </li>
            </ol>
        </div>
    </section>

    @* -------------------------------------------------- for accountants *@
    <section class="section" id="accountants">
        <div class="shell split">
            <div class="split-text">
                <p class="eyebrow">@Marketing.Accountants_Eyebrow</p>
                <h2 class="section-title left">@Marketing.Accountants_Title</h2>
                <p class="lead">@Marketing.Accountants_Lead</p>

                <ul class="points">
                    <li>
                        <strong>@Marketing.Accountants_Point1_Title</strong>
                        <span>@Marketing.Accountants_Point1_Desc</span>
                    </li>
                    <li>
                        <strong>@Marketing.Accountants_Point2_Title</strong>
                        <span>@Marketing.Accountants_Point2_Desc</span>
                    </li>
                    <li>
                        <strong>@Marketing.Accountants_Point3_Title</strong>
                        <span>@Marketing.Accountants_Point3_Desc</span>
                    </li>
                </ul>

                <a class="btn-grad" href="/Account/Register">@Marketing.Accountants_Cta</a>
            </div>

            @* Pure CSS/SVG stand-in for the accountant dashboard. No real
               client names, no real figures — see Accountants_Mock_Caption. *@
            <div class="split-visual" aria-hidden="true">
                <div class="mock">
                    <div class="mock-bar">
                        <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                        <span class="mock-bar-title">@Marketing.Accountants_Mock_Title</span>
                    </div>

                    <div class="mock-head">
                        <span>@Marketing.Accountants_Mock_Title</span>
                        <span>@Marketing.Accountants_Mock_ColumnBalance</span>
                        <span>@Marketing.Accountants_Mock_ColumnForecast</span>
                    </div>

                    <div class="mock-row">
                        <span class="mock-name">@Marketing.Accountants_Mock_Client1</span>
                        <span class="mock-val">@Marketing.Accountants_Mock_Value1</span>
                        <span class="mock-spark">
                            <svg viewBox="0 0 64 24" class="spark">
                                <path d="M2 17 L14 13 L26 14 L36 9" />
                                <path d="M36 9 L62 4" stroke-dasharray="3 2.5" />
                            </svg>
                        </span>
                        <span class="pill pill-ok">@Marketing.Accountants_Mock_StatusOk</span>
                    </div>

                    <div class="mock-row">
                        <span class="mock-name">@Marketing.Accountants_Mock_Client2</span>
                        <span class="mock-val">@Marketing.Accountants_Mock_Value2</span>
                        <span class="mock-spark">
                            <svg viewBox="0 0 64 24" class="spark spark-watch">
                                <path d="M2 10 L14 12 L26 11 L36 14" />
                                <path d="M36 14 L62 16" stroke-dasharray="3 2.5" />
                            </svg>
                        </span>
                        <span class="pill pill-watch">@Marketing.Accountants_Mock_StatusWatch</span>
                    </div>

                    <div class="mock-row">
                        <span class="mock-name">@Marketing.Accountants_Mock_Client3</span>
                        <span class="mock-val">@Marketing.Accountants_Mock_Value3</span>
                        <span class="mock-spark">
                            <svg viewBox="0 0 64 24" class="spark spark-risk">
                                <path d="M2 7 L14 10 L26 13 L36 15" />
                                <path d="M36 15 L62 21" stroke-dasharray="3 2.5" />
                            </svg>
                        </span>
                        <span class="pill pill-risk">@Marketing.Accountants_Mock_StatusRisk</span>
                    </div>
                </div>
                <p class="mock-caption">@Marketing.Accountants_Mock_Caption</p>
            </div>
        </div>
    </section>

    @* ---------------------------------------------------------- pricing *@
    <section class="section section-alt" id="pricing">
        <div class="shell">
            <h2 class="section-title">@Marketing.Pricing_Title</h2>
            <p class="section-sub">@Marketing.Pricing_Subtitle</p>

            <div class="plans">
                <article class="plan">
                    <h3 class="plan-name">@Marketing.Pricing_Free_Name</h3>
                    <p class="plan-price">
                        <span class="plan-amount">@Marketing.Pricing_Free_Price</span>
                        <span class="plan-period">@Marketing.Pricing_Free_Period</span>
                    </p>
                    <p class="plan-desc">@Marketing.Pricing_Free_Desc</p>
                    <ul class="plan-list">
                        <li>@Marketing.Pricing_Free_Feature1</li>
                        <li>@Marketing.Pricing_Free_Feature2</li>
                        <li>@Marketing.Pricing_Free_Feature3</li>
                    </ul>
                </article>

                @* Recommended: gradient border via a padded gradient wrapper. *@
                <div class="plan-featured">
                    <article class="plan plan-inner">
                        <span class="plan-badge">@Marketing.Pricing_Recommended</span>
                        <h3 class="plan-name">@Marketing.Pricing_Pro_Name</h3>
                        <p class="plan-price">
                            <span class="plan-amount">@Marketing.Pricing_Pro_Price</span>
                            <span class="plan-period">@Marketing.Pricing_Pro_Period</span>
                        </p>
                        <p class="plan-desc">@Marketing.Pricing_Pro_Desc</p>
                        <ul class="plan-list">
                            <li>@Marketing.Pricing_Pro_Feature1</li>
                            <li>@Marketing.Pricing_Pro_Feature2</li>
                            <li>@Marketing.Pricing_Pro_Feature3</li>
                        </ul>
                    </article>
                </div>

                <article class="plan">
                    <h3 class="plan-name">@Marketing.Pricing_Enterprise_Name</h3>
                    <p class="plan-price">
                        <span class="plan-amount plan-amount-sm">@Marketing.Pricing_Enterprise_Price</span>
                    </p>
                    <p class="plan-desc">@Marketing.Pricing_Enterprise_Desc</p>
                    <ul class="plan-list">
                        <li>@Marketing.Pricing_Enterprise_Feature1</li>
                        <li>@Marketing.Pricing_Enterprise_Feature2</li>
                        <li>@Marketing.Pricing_Enterprise_Feature3</li>
                    </ul>
                </article>
            </div>

            <p class="plans-note">@Marketing.Pricing_Note</p>
        </div>
    </section>

    @* ----------------------------------------------------------- footer *@
    <footer class="footer">
        <div class="shell footer-inner">
            <div class="footer-brand">
                <RoivoLogo Size="40" ShowTagline="true" WordmarkColor="#FFFFFF" />
                <p class="footer-blurb">@Marketing.Footer_Blurb</p>
            </div>

            <nav class="footer-links" aria-label="@Marketing.Legal_TableOfContents">
                <a href="/privacy">@Marketing.Footer_Privacy</a>
                <a href="/terms">@Marketing.Footer_Terms</a>
            </nav>
        </div>

        <div class="shell footer-legal">
            <span>@Marketing.Footer_Copyright</span>
        </div>
    </footer>

</div>

@code {
    /// <summary>
    /// Signed-in visitors are sent into the app. The marketing page is for
    /// people who are not customers yet; an accountant who lands on "/" from a
    /// bookmark should get their workspace, not a pricing table.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
            return;

        var isAccountant = string.Equals(
            authState.User.FindFirst("tenant_type")?.Value,
            nameof(Roivo.Core.Domain.Enums.TenantType.Accountant),
            StringComparison.Ordinal);

        Nav.NavigateTo(isAccountant ? "/accountant/dashboard" : "/dashboard", replace: true);
    }
}
