@page "/businesses/{Id:guid}/tax-calendar"
@attribute [Authorize]

@using System.Globalization
@using Roivo.Application.Features.Businesses.Queries.GetBusinessById
@using Roivo.Application.Features.Cashflow.Commands.MarkTaxPaid
@using Roivo.Application.Features.Cashflow.Queries.GetTaxCalendar
@* The query's result record is also called TaxCalendar, which both the page
   class and the resource class name would shadow; the alias keeps it nameable. *@
@using TaxCalendarData = Roivo.Application.Features.Cashflow.Queries.GetTaxCalendar.TaxCalendar
@using Roivo.Web.Components.Shared
@inject GetBusinessByIdHandler GetBusinessHandler
@inject GetTaxCalendarHandler GetCalendarHandler
@inject MarkTaxPaidHandler MarkPaidHandler
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<RoivoPageTitle Title="@(Roivo.Resources.Cashflow.TaxCalendar)" />

@* MudSimpleTable exposes Style on its wrapper div, not on the inner <table>,
   so table-layout cannot be set from a parameter and this page owns no
   isolated stylesheet. A page-local <style> is the narrowest way to pin the
   layout algorithm the <colgroup> widths depend on. *@
<style>
    .rv-tax-table table {
        table-layout: fixed;
        width: 100%;
    }

    .rv-tax-table th,
    .rv-tax-table td {
        overflow-wrap: anywhere;
    }

    /* Status chips differ in text length; a full-width chip keeps the column
       reading as one aligned band down the page. */
    .rv-tax-table td.rv-tax-status .mud-chip {
        width: 100%;
        margin: 0;
        justify-content: center;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <MudPaper Class="pa-4 mb-4">
        <BusinessBreadcrumbs BusinessId="Id" BusinessName="@business?.Name"
                             ParentPage="@Roivo.Resources.Cashflow.Title"
                             ParentHref="@($"/businesses/{Id}/cashflow")"
                             CurrentPage="@Roivo.Resources.Cashflow.TaxCalendar" />
        <MudText Typo="Typo.h5">@Roivo.Resources.Cashflow.TaxCalendar</MudText>
    </MudPaper>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        @Roivo.Resources.Cashflow.EstimateDisclaimer
    </MudAlert>

    @if (loading)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4"><SkeletonText Height="2.5rem" /></MudItem>
                <MudItem xs="12" sm="6" md="4"><SkeletonText Announce="false" Height="2.5rem" Width="60%" /></MudItem>
            </MudGrid>
        </MudPaper>

        @for (var g = 0; g < 2; g++)
        {
            <MudPaper Class="pa-4 mb-4">
                <SkeletonText Announce="false" Width="35%" Height="0.9rem" Class="mb-3" />
                <SkeletonTable Announce="false" Rows="3" Columns="6" />
            </MudPaper>
        }
    }
    else if (business is null)
    {
        <MudAlert Severity="Severity.Warning">@Common.Error_NotFound</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int"
                               Label="@Roivo.Resources.Cashflow.QuarterFilter"
                               Value="@quarter"
                               ValueChanged="OnQuarterChanged">
                        @for (var q = 1; q <= 4; q++)
                        {
                            var value = q;
                            <MudSelectItem Value="@value">@($"{year}-Q{value}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft"
                                   OnClick="@(() => ShiftYear(-1))" />
                    <MudText Typo="Typo.subtitle1" Class="mx-2">@year</MudText>
                    <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                   OnClick="@(() => ShiftYear(1))" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (reloading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-2" />
        }

        @if (calendar is null || calendar.Obligations.Count == 0)
        {
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.body2">@Roivo.Resources.Cashflow.NoObligations</MudText>
            </MudPaper>
        }
        else
        {
            @foreach (var group in calendar.Obligations.GroupBy(o => o.DueDate).OrderBy(g => g.Key))
            {
                <MudPaper Class="pa-4 mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1">
                            @Roivo.Resources.Cashflow.DueDate: @group.Key.ToString("dd/MM/yyyy")
                        </MudText>
                    </MudStack>

                    @* One table per due-date group meant the browser sized each
                       one independently and the columns drifted between groups.
                       Fixed widths make the groups scan as a single table. *@
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <div class="rv-tax-table">
                            <MudSimpleTable Dense="true" Hover="true">
                                <colgroup>
                                    <col style="width:30%" />
                                    <col style="width:12%" />
                                    <col style="width:15%" />
                                    <col style="width:15%" />
                                    <col style="width:13%" />
                                    <col style="width:15%" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>@Roivo.Resources.Cashflow.CategoryType</th>
                                        <th>@Roivo.Resources.Cashflow.Period</th>
                                        <th>@Roivo.Resources.Cashflow.EstimatedAmount</th>
                                        <th>@Roivo.Resources.Cashflow.ActualAmount</th>
                                        <th>@Reconciliation.Column_Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var obligation in group.OrderBy(o => o.TaxType))
                                    {
                                        <tr>
                                            <td>@TaxTypeLabel(obligation.TaxType)</td>
                                            <td>@obligation.Period</td>
                                            <td>@FormatCurrency(obligation.EstimatedAmount)</td>
                                            <td>@(obligation.ActualAmount is { } actual ? FormatCurrency(actual) : "—")</td>
                                            <td class="rv-tax-status">
                                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(obligation)">
                                                    @StatusLabel(obligation)
                                                </MudChip>
                                            </td>
                                            <td>
                                                @if (!obligation.IsPaid)
                                                {
                                                    <MudButton Size="Size.Small"
                                                               FullWidth="true"
                                                               Variant="Variant.Outlined"
                                                               StartIcon="@Icons.Material.Outlined.Done"
                                                               OnClick="@(() => OpenMarkPaid(obligation))">
                                                        @Roivo.Resources.Cashflow.MarkAsPaid
                                                    </MudButton>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    </MudHidden>

                    @* Below sm the six columns cannot fit a phone, so each
                       obligation becomes a card led by its status. *@
                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                        @foreach (var obligation in group.OrderBy(o => o.TaxType))
                        {
                            <MudPaper Outlined="true" Class="pa-3 mb-2">
                                <MudChip T="string" Size="Size.Small" Class="mb-2"
                                         Color="@StatusColor(obligation)">
                                    @StatusLabel(obligation)
                                </MudChip>
                                <MudText Typo="Typo.subtitle2">@TaxTypeLabel(obligation.TaxType)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                                    @Roivo.Resources.Cashflow.Period: @obligation.Period
                                </MudText>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Roivo.Resources.Cashflow.EstimatedAmount</MudText>
                                    <MudText Typo="Typo.body2">@FormatCurrency(obligation.EstimatedAmount)</MudText>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Roivo.Resources.Cashflow.ActualAmount</MudText>
                                    <MudText Typo="Typo.body2">@(obligation.ActualAmount is { } cardActual ? FormatCurrency(cardActual) : "—")</MudText>
                                </MudStack>
                                @if (!obligation.IsPaid)
                                {
                                    <MudButton FullWidth="true"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Outlined.Done"
                                               OnClick="@(() => OpenMarkPaid(obligation))">
                                        @Roivo.Resources.Cashflow.MarkAsPaid
                                    </MudButton>
                                }
                            </MudPaper>
                        }
                    </MudHidden>
                </MudPaper>
            }
        }
    }
</MudContainer>

<MudDialog @bind-Visible="markPaidVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">@Roivo.Resources.Cashflow.MarkAsPaid</MudText>
    </TitleContent>
    <DialogContent>
        @if (selected is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                @TaxTypeLabel(selected.TaxType) · @Roivo.Resources.Cashflow.Period: @selected.Period
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4">
                @Roivo.Resources.Cashflow.EstimatedAmount: @FormatCurrency(selected.EstimatedAmount)
            </MudText>
        }

        <MudNumericField T="decimal"
                         @bind-Value="actualAmount"
                         Label="@Roivo.Resources.Cashflow.ActualAmount"
                         Min="0"
                         Immediate="true" />

        @if (!string.IsNullOrEmpty(dialogError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@dialogError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => markPaidVisible = false)">
            @Common.CancelButton
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="ConfirmMarkPaid"
                   Disabled="@saving">
            @(saving ? Common.Saving : Common.ConfirmButton)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private bool reloading;
    private bool saving;

    private Business? business;
    private TaxCalendarData? calendar;

    private int year = DateTime.UtcNow.Year;
    private int quarter = (DateTime.UtcNow.Month - 1) / 3 + 1;

    private bool markPaidVisible;
    private TaxObligation? selected;
    private decimal actualAmount;
    private string? dialogError;

    protected override async Task OnInitializedAsync()
    {
        business = await GetBusinessHandler.Handle(
            new GetBusinessByIdQuery(Id, ActiveOnly: true), CancellationToken.None);

        if (business is null)
        {
            loading = false;
            return;
        }

        await LoadCalendarAsync();
        loading = false;
    }

    private async Task LoadCalendarAsync()
    {
        reloading = true;
        try
        {
            var from = QuarterStart(year, quarter);
            var to = QuarterStart(year, quarter).AddMonths(3).AddDays(-1);
            calendar = await GetCalendarHandler.Handle(
                new GetTaxCalendarQuery(Id, from, to), CancellationToken.None);
        }
        finally
        {
            reloading = false;
        }
    }

    private async Task OnQuarterChanged(int value)
    {
        quarter = value;
        await LoadCalendarAsync();
    }

    private async Task ShiftYear(int delta)
    {
        year += delta;
        await LoadCalendarAsync();
    }

    private void OpenMarkPaid(TaxObligation obligation)
    {
        selected = obligation;
        // The estimate is the most likely figure, so it seeds the input rather
        // than making the user retype it.
        actualAmount = obligation.ExpectedAmount;
        dialogError = null;
        markPaidVisible = true;
    }

    private async Task ConfirmMarkPaid()
    {
        if (selected is null) return;

        saving = true;
        dialogError = null;
        try
        {
            var result = await MarkPaidHandler.Handle(
                new MarkTaxPaidCommand(selected.Id, actualAmount, DateTime.UtcNow),
                CancellationToken.None);

            switch (result)
            {
                case MarkTaxPaidResult.Success:
                    Snackbar.Add(Roivo.Resources.Cashflow.TaxMarkedPaid, Severity.Success);
                    markPaidVisible = false;
                    selected = null;
                    await LoadCalendarAsync();
                    return;
                case MarkTaxPaidResult.Forbidden:
                    dialogError = Common.Error_Forbidden;
                    return;
                case MarkTaxPaidResult.NotFound:
                    dialogError = Common.Error_NotFound;
                    return;
                case MarkTaxPaidResult.AlreadyPaid:
                    dialogError = Roivo.Resources.Cashflow.Error_AlreadyPaid;
                    return;
                case MarkTaxPaidResult.InvalidAmount:
                    dialogError = Roivo.Resources.Cashflow.Error_InvalidAmount;
                    return;
                default:
                    dialogError = Common.Error_Generic;
                    return;
            }
        }
        finally
        {
            saving = false;
        }
    }

    private static DateOnly QuarterStart(int year, int quarter)
        => new(year, (quarter - 1) * 3 + 1, 1);

    private static string TaxTypeLabel(TaxType taxType) => taxType switch
    {
        TaxType.Vat => Roivo.Resources.Cashflow.Tax_Vat,
        TaxType.IncomeTax => Roivo.Resources.Cashflow.Tax_IncomeTax,
        TaxType.WithholdingTax => Roivo.Resources.Cashflow.Tax_WithholdingTax,
        TaxType.SocialSecurity => Roivo.Resources.Cashflow.Tax_SocialSecurity,
        TaxType.ProfessionalTax => Roivo.Resources.Cashflow.Tax_ProfessionalTax,
        TaxType.TaxPrepayment => Roivo.Resources.Cashflow.Tax_TaxPrepayment,
        _ => Roivo.Resources.Cashflow.TaxCalendar,
    };

    private static string StatusLabel(TaxObligation obligation)
    {
        if (obligation.IsPaid) return Roivo.Resources.Cashflow.Status_Paid;
        return obligation.IsOverdue(Today)
            ? Roivo.Resources.Cashflow.Status_Overdue
            : Roivo.Resources.Cashflow.Status_Pending;
    }

    private static Color StatusColor(TaxObligation obligation)
    {
        if (obligation.IsPaid) return Color.Success;
        return obligation.IsOverdue(Today) ? Color.Error : Color.Warning;
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private static string FormatCurrency(decimal value)
        => string.Format(CultureInfo.GetCultureInfo("el-GR"), "{0:C}", value);
}
