@using Roivo.Web.Configuration
<!DOCTYPE html>
<html lang="@(Strings.IsEnglish ? "en" : "el")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Roivo.Web.styles.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <!-- Rasterised from the brand mark by tools/make_icons.py. Several sizes
         rather than one, so hi-DPI tabs and the install prompt each pick the
         one they need instead of upscaling the 32px. -->
    <link rel="icon" type="image/png" sizes="32x32" href="favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />

    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="@RoivoTheme.Navy" />
    <meta name="application-name" content="Roivo" />
    <meta name="apple-mobile-web-app-title" content="Roivo" />

    <meta name="description" content="@Marketing.MetaDescription" />
    <meta property="og:title" content="Roivo — Cashflow Intelligence" />
    <meta property="og:description" content="@Marketing.MetaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Roivo" />
    <meta property="og:image" content="icon-512.png" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
