@*
    Product navigation, ported from the Figma design.

    Plain markup rather than MudNavMenu: the design's sidebar is a bespoke
    composition (brand lockup, workspace switcher, grouped sections, count
    badges, a pinned footer) whose CSS is already in roivo-app.css. Rebuilding
    it out of MudBlazor would mean overriding most of what MudNavMenu renders,
    which is more work and drifts from the design on every MudBlazor upgrade.
*@

@using Roivo.Resources
@inject NavigationManager Nav

<aside class="app-sidebar">
    @* The design pairs the lockup with the collapse control on one row. Our own
       brand mark stays: the design's is a placeholder drawn in SVG. *@
    <div class="sidebar-brand-row">
        <span class="brand">
            <span class="brand-mark"><img src="icon-192.png" alt="@Marketing.BrandName" /></span>
            <span>
                @* The dotless ı is the design's: the dot is drawn by CSS on
                   .wordmark-i so it can carry the brand gradient. *@
                <strong>Ro<span class="wordmark-i">ı</span>vo</strong>
                <small>@Shell.BrandTagline</small>
            </span>
        </span>

        <button type="button" class="sidebar-collapse"
                aria-label="@(Collapsed ? Shell.Sidebar_Expand : Shell.Sidebar_Collapse)"
                aria-expanded="@((!Collapsed).ToString().ToLowerInvariant())"
                title="@(Collapsed ? Shell.Sidebar_Expand : Shell.Sidebar_Collapse)"
                @onclick="OnToggleCollapsed">
            <RoivoIcon Name="RoivoIconName.Arrow" Size="14" />
        </button>
    </div>

    @if (IsAccountant)
    {
        <div class="workspace-switcher">
            <span>@Shell.Group_Workspace</span>

            <button type="button" class="@(SelectedBusinessId is null ? "is-active" : "")"
                    @onclick="() => SelectBusiness(null)">
                <span class="workspace-company">@BusinessEmoji.Practice</span>
                <strong>@Shell.AccountantWorkspace</strong>
            </button>

            @foreach (var business in Businesses)
            {
                <button type="button" class="@(SelectedBusinessId == business.Id ? "is-active" : "")"
                        @onclick="() => SelectBusiness(business.Id)">
                    <span class="workspace-company">@BusinessEmoji.For(business.Kad)</span>
                    <strong>@business.Name</strong>
                </button>
            }
        </div>
    }

    <nav class="main-nav" aria-label="@Shell.Nav_Label">
        <span class="nav-group">@Shell.Group_Monitoring</span>
        @NavItem(RoivoIconName.Overview, Shell.Nav_Overview, "dashboard")

        <span class="nav-group">@Shell.Group_Tasks</span>
        @NavItem(RoivoIconName.Cashflow, Shell.Nav_Cashflow, "cashflow")
        @NavItem(RoivoIconName.Reconciliation, Shell.Nav_Reconciliation, "reconciliation", PendingMatches)
        @NavItem(RoivoIconName.Obligations, Shell.Nav_Obligations, "obligations", UpcomingObligations, warning: true)
        @NavItem(RoivoIconName.Reports, Shell.Nav_Reports, "reports")

        <span class="nav-group">@Shell.Group_Management</span>
        @NavItem(RoivoIconName.Connections, Shell.Nav_Connections, "connections")
    </nav>

    <div class="sidebar-bottom">
        @NavItem(RoivoIconName.Help, Shell.Nav_Help, "help")
        @NavItem(RoivoIconName.Settings, Shell.Nav_Settings, "settings")

        <div class="account-card">
            <span class="avatar">@Initials(UserName)</span>
            <span>
                <strong>@ShortName(UserName)</strong>
                <small>@UserRole</small>
            </span>
        </div>
    </div>
</aside>

@code {
    /// <summary>Businesses the signed-in tenant can switch between.</summary>
    [Parameter] public IReadOnlyList<BusinessOption> Businesses { get; set; } = [];

    /// <summary>Null means the consolidated accountant workspace, not a single client.</summary>
    [Parameter] public Guid? SelectedBusinessId { get; set; }

    [Parameter] public EventCallback<Guid?> SelectedBusinessIdChanged { get; set; }

    /// <summary>Business owners have one business, so they get no switcher.</summary>
    [Parameter] public bool IsAccountant { get; set; }

    /// <summary>Icons-only rail. The shell owns the state; this only reports it.</summary>
    [Parameter] public bool Collapsed { get; set; }

    [Parameter] public EventCallback OnToggleCollapsed { get; set; }

    /// <summary>Who is signed in, for the card pinned to the bottom.</summary>
    [Parameter] public string UserName { get; set; } = "";

    /// <summary>Their role, shown under the name.</summary>
    [Parameter] public string UserRole { get; set; } = "";

    /// <summary>Badge counts. Zero and null both render no badge.</summary>
    [Parameter] public int? PendingMatches { get; set; }

    [Parameter] public int? UpcomingObligations { get; set; }

    /// <summary>One row of the switcher.</summary>
    /// <param name="Kad">Activity code, which chooses the switcher glyph.</param>
    public sealed record BusinessOption(Guid Id, string Name, string? Kad);

    private RenderFragment NavItem(
        RoivoIconName icon, string label, string segment, int? badge = null, bool warning = false) =>
        @<button type="button"
                 class="nav-item @(IsActive(segment) ? "is-active" : "")"
                 @onclick="() => Go(segment)">
            <RoivoIcon Name="icon" />
            <span>@label</span>
            @if (badge is > 0)
            {
                <b class="@(warning ? "warning-count" : "")">@badge</b>
            }
        </button>;

    private void Go(string segment) => Nav.NavigateTo("/" + segment);

    /// <summary>
    /// Lit for the section you are in and anything beneath it, compared
    /// segment-wise so /reports never lights for a /reports-archive.
    /// </summary>
    private bool IsActive(string segment)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = path.IndexOfAny(['?', '#']);
        if (cut >= 0) path = path[..cut];
        path = path.Trim('/');

        return path.Equals(segment, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(segment + "/", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Up to two letters for the switcher avatar. Greek company names routinely
    /// start with an article or a legal form, so the first two *words* read
    /// better than the first two letters.
    /// </summary>
    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return words.Length switch
        {
            0 => "—",
            1 => words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant(),
            _ => string.Concat(words[0][..1], words[1][..1]).ToUpperInvariant(),
        };
    }

    /// <summary>
    /// "Ευάγγελος Βλάχος" becomes "Ευάγγελος Β." — the design's treatment, and
    /// the only way a long Greek surname fits the sidebar without wrapping.
    /// </summary>
    private static string ShortName(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return words.Length switch
        {
            0 => "",
            1 => words[0],
            _ => $"{words[0]} {words[^1][..1]}.",
        };
    }

    private Task SelectBusiness(Guid? id)
    {
        SelectedBusinessId = id;
        return SelectedBusinessIdChanged.InvokeAsync(id);
    }
}
