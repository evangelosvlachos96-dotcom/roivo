@*
    The forecast line from the dashboard, drawn as inline SVG.

    The design draws this by hand rather than with a charting library, and that
    is worth keeping: no JS interop, no client-side dependency, and it renders
    with the first server response instead of after a round trip. The geometry
    below (viewBox, gradients, stroke weights, the terminal dot) is the
    design's; only the path data is computed from real figures.
*@

@using Roivo.Application.Features.Cashflow.Services

<svg class="owner-chart" viewBox="0 0 @Width 210" preserveAspectRatio="none"
     role="img" aria-label="@AriaLabel">
    <defs>
        <linearGradient id="@_areaId" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2389ee" stop-opacity=".24" />
            <stop offset="1" stop-color="#2389ee" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="@_lineId" x1="0" y1="0" x2="1" y2="0">
            <stop stop-color="#2389ee" />
            <stop offset="1" stop-color="#28c5ad" />
        </linearGradient>
    </defs>

    <path class="chart-grid" d="M0 35H@(Width)M0 95H@(Width)M0 155H@(Width)" />

    @if (_line.Length > 0)
    {
        <path d="@(_line + $" V210 H0Z")" fill="url(#@_areaId)" />
        <path d="@_line" fill="none" stroke="url(#@_lineId)" stroke-width="4" stroke-linecap="round" />
        <circle cx="@Width" cy="@_endY" r="6" fill="#28c5ad" />
        <circle cx="@Width" cy="@_endY" r="11" fill="#28c5ad" opacity=".13" />
    }
</svg>

@code {
    /// <summary>The projection to plot, oldest first.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<DailyForecast> Points { get; set; } = [];

    [Parameter] public string AriaLabel { get; set; } = "";

    /// <summary>viewBox width. The design's is 720; the height is fixed at 210.</summary>
    private const int Width = 720;

    // Keep the plot off the very top and bottom edges, as the design does.
    private const double Top = 20;
    private const double Bottom = 185;

    // Gradient ids must be unique per instance: two charts on one page with the
    // same id make the second inherit the first one's gradient.
    private readonly string _areaId = $"owner-area-{Guid.NewGuid():N}";
    private readonly string _lineId = $"owner-line-{Guid.NewGuid():N}";

    private string _line = "";
    private double _endY = Bottom;

    protected override void OnParametersSet()
    {
        if (Points.Count < 2)
        {
            _line = "";
            return;
        }

        var balances = Points.Select(p => (double)p.PredictedBalance).ToArray();
        var min = balances.Min();
        var max = balances.Max();

        // A flat line would divide by zero; draw it through the middle instead.
        var span = max - min;
        double Y(double value) => span < 0.0001
            ? (Top + Bottom) / 2
            : Bottom - ((value - min) / span * (Bottom - Top));

        var step = (double)Width / (balances.Length - 1);
        var points = balances.Select((b, i) => (X: i * step, Y: Y(b))).ToArray();

        _endY = Math.Round(points[^1].Y, 1);
        _line = BuildPath(points);
    }

    /// <summary>
    /// A Catmull-Rom spline converted to cubic Béziers, which is what gives the
    /// design's curve its easy sweep. A polyline through ninety daily points
    /// would read as noise at this size.
    /// </summary>
    private static string BuildPath((double X, double Y)[] p)
    {
        var path = new System.Text.StringBuilder(p.Length * 24);
        path.Append(Invariant($"M{p[0].X:0.#} {p[0].Y:0.#}"));

        for (var i = 0; i < p.Length - 1; i++)
        {
            var p0 = p[Math.Max(i - 1, 0)];
            var p1 = p[i];
            var p2 = p[i + 1];
            var p3 = p[Math.Min(i + 2, p.Length - 1)];

            // The sixth is the standard Catmull-Rom tension.
            var c1X = p1.X + (p2.X - p0.X) / 6;
            var c1Y = p1.Y + (p2.Y - p0.Y) / 6;
            var c2X = p2.X - (p3.X - p1.X) / 6;
            var c2Y = p2.Y - (p3.Y - p1.Y) / 6;

            path.Append(Invariant(
                $" C{c1X:0.#} {c1Y:0.#} {c2X:0.#} {c2Y:0.#} {p2.X:0.#} {p2.Y:0.#}"));
        }

        return path.ToString();
    }

    /// <summary>
    /// SVG path data is always invariant. Under a Greek culture the default
    /// formatter emits a comma decimal separator, which browsers read as a
    /// coordinate separator and the curve collapses.
    /// </summary>
    private static string Invariant(FormattableString value) =>
        FormattableString.Invariant(value);
}
