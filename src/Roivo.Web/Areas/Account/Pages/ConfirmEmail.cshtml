@page
@model Roivo.Web.Areas.Account.Pages.ConfirmEmailModel
@using Roivo.Resources
@{
    ViewData["Title"] = Auth.ConfirmEmail_PageTitle;
}

@if (Model.Succeeded)
{
    <h2 class="h4 mb-3 text-success">@Auth.ConfirmEmail_Success_Heading</h2>
    <p>@Auth.ConfirmEmail_Success_Body</p>
    <a asp-page="/Login" class="btn btn-primary w-100 mt-2">@Auth.Login_PageTitle</a>
}
else
{
    <h2 class="h4 mb-3 text-danger">@Auth.ConfirmEmail_Failure_Heading</h2>
    <p>@Auth.ConfirmEmail_TokenInvalid</p>
    <a asp-page="/Register" class="btn btn-outline-secondary w-100 mt-2">@Auth.RegisterAgainLink</a>
}
