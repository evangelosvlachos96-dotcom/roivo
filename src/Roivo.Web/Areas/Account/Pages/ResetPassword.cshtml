@page
@model Roivo.Web.Areas.Account.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Νέος κωδικός";
}

@if (Model.Succeeded)
{
    <h2 class="h4 mb-3 text-success">Ο κωδικός άλλαξε</h2>
    <p>Μπορείς τώρα να συνδεθείς με τον νέο σου κωδικό.</p>
    <a asp-page="/Login" class="btn btn-primary w-100 mt-2">Σύνδεση</a>
}
else
{
    <h2 class="h4 mb-3">Όρισε νέο κωδικό</h2>

    <form method="post">
        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Token" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">Νέος κωδικός</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
            <div class="form-text">Τουλάχιστον 12 χαρακτήρες, με κεφαλαίο, αριθμό και σύμβολο.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">Επιβεβαίωση κωδικού</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Αλλαγή κωδικού</button>
    </form>
}
