@*
    The Roivo mark for the Account area.

    Razor Pages cannot consume the canonical RoivoLogo.razor Blazor component,
    so the mark is redrawn here — but only once, as a partial rendered by
    _Layout, rather than pasted into each page. The geometry deliberately
    matches RoivoLogo.razor: an "R" whose stem is three ascending bars, in the
    teal-to-blue gradient. Keep the two in sync; an auth screen showing a
    different "R" from the app bar reads as a different product, or a phishing
    page.
*@

<a href="/" class="roivo-auth-brand" aria-label="@Roivo.Resources.Marketing.BrandName">
    <svg class="roivo-auth-logo" viewBox="0 0 48 48" fill="none"
         role="img" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="roivoAuthMark" x1="4" y1="44" x2="48" y2="6"
                            gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#2DD4BF" />
                <stop offset="1" stop-color="#1E88E5" />
            </linearGradient>
        </defs>

        @* Three ascending bars on the baseline; the tallest is also the R's stem. *@
        <rect x="4" y="31" width="6" height="11" rx="2" fill="url(#roivoAuthMark)" />
        <rect x="12" y="24" width="6" height="18" rx="2" fill="url(#roivoAuthMark)" />
        <rect x="20" y="6" width="7" height="36" rx="2.5" fill="url(#roivoAuthMark)" />

        @* Bowl of the R, springing from the stem. *@
        <path d="M25 9.5 H33 a8.5 8.5 0 0 1 0 17 H25"
              stroke="url(#roivoAuthMark)" stroke-width="7"
              stroke-linecap="butt" fill="none" />

        @* Leg, sweeping down-right out of the bowl. *@
        <path d="M28 26 L41 42"
              stroke="url(#roivoAuthMark)" stroke-width="7"
              stroke-linecap="round" fill="none" />
    </svg>

    <span class="roivo-auth-wordmark">@Roivo.Resources.Marketing.BrandName</span>
    <span class="roivo-auth-tagline">@Roivo.Resources.Marketing.Tagline</span>
</a>
