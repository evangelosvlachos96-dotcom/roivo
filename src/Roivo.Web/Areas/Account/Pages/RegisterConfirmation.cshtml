@page
@model Roivo.Web.Areas.Account.Pages.RegisterConfirmationModel
@using Roivo.Resources
@{
    ViewData["Title"] = Auth.ConfirmEmail_PageTitle;
}

<h2 class="h4 mb-3">@Auth.ForgotPassword_CheckInbox</h2>
<p>
    @Auth.RegisterConfirmation_SentTo
    <strong>@(string.IsNullOrWhiteSpace(Model.Email) ? Auth.ConfirmEmail_Pending_YourEmailFallback : Model.Email)</strong>.
</p>
<p class="text-muted small">
    @Auth.RegisterConfirmation_Instructions
</p>
<p class="small mt-4">
    @Auth.RegisterConfirmation_NotReceived <a asp-page="/Register">@Auth.RegisterAgainLink</a>
</p>
