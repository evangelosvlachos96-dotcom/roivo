@page
@model Roivo.Web.Areas.Account.Pages.RegisterModel
@using Roivo.Resources
@{
    ViewData["Title"] = Auth.Register_PageTitle;
}

<h2 class="h4 mb-3">@Auth.Register_Heading</h2>
<p class="text-muted small mb-4">@Auth.Register_Subtitle</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="mb-3">
        <label class="form-label fw-semibold d-block">@Auth.Register_TenantTypeLabel</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Input.Type" id="type-accountant" value="Accountant" />
            <label class="form-check-label" for="type-accountant">@Auth.Register_TenantType_Accountant</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Input.Type" id="type-business" value="Business" />
            <label class="form-check-label" for="type-business">@Auth.Register_TenantType_BusinessOwner</label>
        </div>
        <span asp-validation-for="Input.Type" class="text-danger d-block small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.FullName" class="form-label">@Auth.Register_FullNameLabel</label>
        <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@Auth.Login_EmailLabel</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    @* Password re-rendered intentionally on validation failures so users don't
       retype after fixing unrelated errors (e.g., AFM duplicate confirmation).
       This is a recognized UX tradeoff — the password lives briefly in the
       form's HTML during re-render but never leaves the user's browser context. *@
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">@Auth.Login_PasswordLabel</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" value="@Model.Input.Password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
        <div class="form-text">@Auth.PasswordRequirementsHint</div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">@Auth.Register_ConfirmPasswordLabel</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" value="@Model.Input.ConfirmPassword" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.OrganizationName" class="form-label">@Auth.Register_OrganizationNameLabel</label>
        <input asp-for="Input.OrganizationName" class="form-control" placeholder=Auth.Register_OrganizationNamePlaceholder />
        <span asp-validation-for="Input.OrganizationName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Afm" class="form-label">@Auth.Register_AfmLabel</label>
        <input asp-for="Input.Afm" class="form-control" inputmode="numeric" maxlength="9" />
        <span asp-validation-for="Input.Afm" class="text-danger small"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="Input.AcceptTerms" class="form-check-input" />
        <label asp-for="Input.AcceptTerms" class="form-check-label small">
            @Auth.Register_AcceptTerms
        </label>
        <span asp-validation-for="Input.AcceptTerms" class="text-danger d-block small"></span>
    </div>

    @if (Model.ShowConfirmDuplicate)
    {
        <div class="alert alert-warning">
            <p>@Auth.Register_DuplicateAfmWarning</p>
            <p class="mb-2">
                <a asp-page="./Login" asp-route-email="@Model.Input.Email">@Auth.Login_PageTitle</a> |
                <a asp-page="./ForgotPassword">@Auth.ResetPassword_PageTitle</a>
            </p>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="Input.ConfirmDuplicate" id="confirmDuplicate" />
                <label class="form-check-label" for="confirmDuplicate">
                    @Auth.Register_ContinueAnyway
                </label>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary w-100">@Auth.Register_PageTitle</button>
</form>

<p class="text-center mt-4 mb-0 small roivo-auth-footnote">
    @Auth.Register_HaveAccountPrompt <a asp-page="/Login">@Auth.Login_PageTitle</a>
</p>
