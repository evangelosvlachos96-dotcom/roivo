@page
@model Roivo.Web.Areas.Account.Pages.ForgotPasswordModel
@using Roivo.Resources
@{
    ViewData["Title"] = Auth.ResetPassword_PageTitle;
}

@if (Model.Submitted)
{
    <h2 class="h4 mb-3">@Auth.ForgotPassword_CheckInbox</h2>
    <p>@Auth.ForgotPassword_Confirmation</p>
    <a asp-page="/Login" class="btn btn-outline-secondary w-100 mt-3">@Auth.ForgotPassword_BackToLogin</a>
}
else
{
    <h2 class="h4 mb-3">@Auth.ForgotPassword_PageTitle</h2>
    <p class="text-muted small mb-4">@Auth.ForgotPassword_Subtitle</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">@Auth.Login_EmailLabel</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">@Auth.ForgotPassword_SubmitButton</button>
    </form>
}
