@page
@model Roivo.Web.Areas.Account.Pages.LoginModel
@using Roivo.Resources
@{
    ViewData["Title"] = Auth.Login_PageTitle;
}
<link rel="stylesheet" href="~/css/roivo-auth.css" />

@* Minimal inline copy of the Roivo mark. Razor Pages cannot consume the
   canonical RoivoLogo.razor Blazor component, so the four auth pages carry
   their own copy of the gradient "R". Keep it in sync with that component. *@
<div class="roivo-auth-brand">
    <svg class="roivo-auth-logo" viewBox="0 0 56 56" role="img" aria-label="Roivo" focusable="false">
        <defs>
            <linearGradient id="roivoAuthMark" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#2DD4BF" />
                <stop offset="100%" stop-color="#1E88E5" />
            </linearGradient>
        </defs>
        <rect width="56" height="56" rx="14" fill="url(#roivoAuthMark)" />
        <path fill="#fff" d="M19 41V15h10.2c5.6 0 9.1 2.9 9.1 7.8 0 3.6-1.9 6.1-5.2 7.2L39.5 41h-6.3l-5.5-9.6h-3.2V41H19zm5.5-14.3h4.2c2.6 0 4.1-1.3 4.1-3.6s-1.5-3.6-4.1-3.6h-4.2v7.2z" />
    </svg>
    <span class="roivo-auth-wordmark">Roivo</span>
</div>


<h2 class="h4 mb-3">@Auth.Login_PageTitle</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success small">@Model.SuccessMessage</div>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@Auth.Login_EmailLabel</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">@Auth.Login_PasswordLabel</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label small">@Auth.Login_RememberMe</label>
    </div>

    <button type="submit" class="btn btn-primary w-100">@Auth.Login_SignInButton</button>
</form>

<div class="roivo-auth-links">
    <a asp-page="/ForgotPassword">@Auth.Login_ForgotPasswordLink</a>
    <a asp-page="/Register">@Auth.Login_NoAccountLink</a>
</div>
