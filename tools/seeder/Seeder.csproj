<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Roivo.DevSeeder</RootNamespace>
    <!-- Not part of the solution build: this is an operator tool, run on
         purpose against a named database, never as part of CI. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Roivo.Infrastructure\Roivo.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Roivo.Aade\Roivo.Aade.csproj" />
    <ProjectReference Include="..\..\src\Roivo.Banking\Roivo.Banking.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.8" />
    <!-- Transitive pin, not a direct dependency: Microsoft.AspNetCore.DataProtection
         pulls System.Security.Cryptography.Xml, and 10.0.8 carries five high-severity
         advisories (CVE-2026-47302 and friends), all patched in 10.0.10. The shipping
         web app resolves this assembly from the Microsoft.AspNetCore.App shared
         framework and is unaffected; only the non-web projects take the NuGet package.
         Remove this pin once the DataProtection packages themselves move past 10.0.9. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
</Project>
